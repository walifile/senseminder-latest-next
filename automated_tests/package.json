{
  "name": "sensepc-automation",
  "version": "1.0.0",
  "type": "module",
  "description": "Automated testing framework using Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test --reporter=html,json,junit",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report reports/playwright-report",
    "test:report:open": "playwright show-report",
    "test:with-report": "playwright test && playwright show-report",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:login": "playwright test --grep @login",
    "test:signup": "playwright test --grep @signup",
    "test:create-new-pc": "playwright test --grep @create-a-new-pc",
    "test:sense-storage": "playwright test --grep @sensestorage",
    "test:user-management": "playwright test --grep @usermanagement",
    "test:assign-pc": "playwright test --grep @assign-pc",
    "test:support": "playwright test --grep @support",
    "test:landing": "playwright test --grep @landing",
    "test:api": "playwright test --grep @api",
    "test:profileandsecurity": "playwright test --grep @profile-and-security",
    "test:api-create-pc": "playwright test --grep @api-create-pc",
    "test:api-delete-pc": "playwright test --grep @api-delete-pc",
    "test:api-billing": "playwright test --grep @api-billing",
    "test:api-billing-payment-methods": "playwright test --grep @api-billing-payment-methods",
    "test:api-billing-recharge": "playwright test --grep @api-billing-recharge",
    "test:api-billing-refund": "playwright test --grep @api-billing-refund-request",
    "test:api-billing-integration": "playwright test --grep @api-billing-integration",
    "test:api-with-ui": "playwright test --grep @api-with-ui-auth",
    "test:api-status": "playwright test --grep @api-with-ui-auth-status",
    "test:api-full-cycle": "playwright test --grep @api-with-ui-auth-full-cycle",
    "test:api-positive": "playwright test --grep '@api-create-pc-basic|@api-create-pc-custom|@api-create-pc-different-configs|@api-create-pc-multiple-instances'",
    "test:critical": "playwright test --grep @critical",
    "test:extended": "playwright test --grep @extended",
    "test:allure": "npm run allure:clean && playwright test --reporter=allure-playwright",
    "test:smoke:allure": "npm run allure:clean && playwright test --grep @smoke --reporter=allure-playwright",
    "test:smoke:allure:ci": "npm run allure:clean && playwright test --grep @smoke --reporter=allure-playwright",
    "test:regression:allure": "npm run allure:clean && playwright test --grep @regression --reporter=allure-playwright",
    "test:regression:allure:ci": "npm run allure:clean && playwright test --grep @regression --reporter=allure-playwright",
    "test:billings:allure": "npm run allure:clean && playwright test --grep @billings --reporter=allure-playwright",
    "test:login:allure": "npm run allure:clean && playwright test --grep @login --reporter=allure-playwright && npm run allure:generate && npm run allure:open",
    "test:login:allure:ci": "npm run allure:clean && playwright test --grep @login --reporter=allure-playwright",
    "test:create-new-pc:allure": "npm run allure:clean && playwright test --grep @create-a-new-pc --reporter=allure-playwright",
    "test:sense-storage:allure": "npm run allure:clean && playwright test --grep @sensestorage --reporter=allure-playwright",
    "test:user-management:allure": "npm run allure:clean && playwright test --grep @usermanagement --reporter=allure-playwright",
    "test:assign-pc:allure": "npm run allure:clean && playwright test --grep @assign-pc --reporter=allure-playwright",
    "test:support:allure": "npm run allure:clean && playwright test --grep @support --reporter=allure-playwright",
    "test:landing:allure": "npm run allure:clean && playwright test --grep @landing --reporter=allure-playwright",
    "test:api:allure": "npm run allure:clean && playwright test --grep @api --reporter=allure-playwright",
    "test:api-create-pc:allure": "npm run allure:clean && playwright test --grep @api-create-pc --reporter=allure-playwright",
    "test:api-delete-pc:allure": "npm run allure:clean && playwright test --grep @api-delete-pc --reporter=allure-playwright",
    "test:api-billing:allure": "npm run allure:clean && playwright test --grep @api-billing --reporter=allure-playwright",
    "test:api-billing-payment-methods:allure": "npm run allure:clean && playwright test --grep @api-billing-payment-methods --reporter=allure-playwright",
    "test:api-billing-recharge:allure": "npm run allure:clean && playwright test --grep @api-billing-recharge --reporter=allure-playwright",
    "test:api-billing-refund:allure": "npm run allure:clean && playwright test --grep @api-billing-refund-request --reporter=allure-playwright",
    "test:api-billing-integration:allure": "npm run allure:clean && playwright test --grep @api-billing-integration --reporter=allure-playwright",
    "test:api-with-ui:allure": "npm run allure:clean && playwright test --grep @api-with-ui-auth --reporter=allure-playwright",
    "test:api-status:allure": "npm run allure:clean && playwright test --grep @api-with-ui-auth-status --reporter=allure-playwright",
    "test:api-full-cycle:allure": "npm run allure:clean && playwright test --grep @api-with-ui-auth-full-cycle --reporter=allure-playwright",
    "test:profileandsecurity:allure": "npm run allure:clean && playwright test --grep @profile-and-security --reporter=allure-playwright",
    "test:profileandsecurity:isolated": "npm run allure:clean && playwright test --grep @profile-and-security --workers=1 --reporter=allure-playwright",
    "test:profileandsecurity:retry": "playwright test --grep @profile-and-security --reporter=allure-playwright",
    "test:loginapitrace:allure": "npm run allure:clean && playwright test --grep @login-api-trace --reporter=allure-playwright",
    "test:signup:allure": "npm run allure:clean && playwright test --grep @signup --reporter=allure-playwright",
    "test:critical:allure": "npm run allure:clean && playwright test --grep @critical --reporter=allure-playwright",
    "test:extended:allure": "npm run allure:clean && playwright test --grep @extended --reporter=allure-playwright",
    "test:mobile": "DEVICE=mobile playwright test",
    "test:tablet": "DEVICE=tablet playwright test",
    "test:responsive": "DEVICE=responsive playwright test",
    "test:mobile:allure": "npm run allure:clean && DEVICE=mobile playwright test --reporter=allure-playwright && npm run allure:generate && npm run allure:open",
    "test:tablet:allure": "npm run allure:clean && DEVICE=tablet playwright test --reporter=allure-playwright && npm run allure:generate && npm run allure:open",
    "test:responsive:allure": "npm run allure:clean && DEVICE=responsive playwright test --reporter=allure-playwright && npm run allure:generate && npm run allure:open",
    "test:chrome:allure": "npm run allure:clean && playwright test --project=chromium --reporter=allure-playwright && npm run allure:generate && npm run allure:open",
    "test:firefox:allure": "npm run allure:clean && playwright test --project=firefox --reporter=allure-playwright && npm run allure:generate && npm run allure:open",
    "test:safari:allure": "npm run allure:clean && playwright test --project=webkit --reporter=allure-playwright && npm run allure:generate && npm run allure:open",
    "allure:generate": "npx allure generate allure-results --output allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:serve": "npx allure open allure-results",
    "allure:generate-and-open": "npm run allure:generate && npm run allure:open",
    "allure:clean": "node scripts/clean-allure.js",
    "allure:share": "node scripts/generate-shareable-report.js",
    "allure:clean-and-serve": "npm run allure:clean && npm run allure:serve",
    "test:allure:clean": "npm run allure:clean && npm run test:allure",
    "retry:failed": "playwright test --last-failed",
    "retry:profileandsecurity": "playwright test --grep @profile-and-security --last-failed",
    "retry:regression": "playwright test --grep @regression --last-failed",
    "retry:login": "playwright test --grep @login --last-failed",
    "retry:signup": "playwright test --grep @signup --last-failed",
    "retry:api": "playwright test --grep @api --last-failed",
    "playwright:install": "playwright install",
    "playwright:install-deps": "playwright install-deps",
    "build": "tsc",
    "start": "echo 'Add your application start command here'",
    "env:setup": "cp env.template .env && echo 'Please edit .env file with your actual credentials'"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@types/otplib": "^7.0.0",
    "allure-js-commons": "^3.3.3",
    "allure-playwright": "^3.3.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "axios": "^1.11.0",
    "dotenv": "^16.3.1",
    "otplib": "^12.0.1",
    "playwright": "^1.40.0"
  }
}
